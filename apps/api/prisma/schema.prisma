generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  PM
  DEVELOPER
}

enum PayType {
  MONTHLY_SALARY
  HOURLY
  PER_PROJECT
  CONTRACTOR
}

enum PensionBase {
  BASIC
  GROSS
}

model Organization {
  id                    String      @id @default(uuid())
  name                  String
  defaultCurrency       String      @default("ETB")
  minimumFloorMargin    Float       @default(0.15) // default 15% floor
  targetMargin          Float       @default(0.30) // default 30% target
  stretchMargin         Float       @default(0.40) // default 40% stretch
  defaultOverheadRate   Float       @default(0.10) // 10% overhead
  defaultContingencyRate Float      @default(0.10) // 10% contingency
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  users                 User[]
  roles                 Role[]
  people                Person[]
  rateCards             RateCard[]
  clients               Client[]
  auditLogs             AuditLog[]
  catalogItems          CatalogItem[]
  exchangeRates         ExchangeRate[]
  exchangeRateHistories ExchangeRateHistory[]
  notifications         Notification[]
  projects              Project[]

  @@map("organizations")
}

model User {
  id             String       @id @default(uuid())
  organizationId String
  email          String       @unique
  passwordHash   String
  name           String
  role           UserRole     @default(DEVELOPER)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  auditLogs      AuditLog[]
  assignedFeatures Feature[]

  @@index([organizationId])
  @@map("users")
}

model Role {
  id                    String       @id @default(uuid())
  organizationId        String
  name                  String
  description           String?
  defaultHourlyCostMinor BigInt      @default(0) // integer minor units
  currency              String       @default("ETB")
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  people                Person[]
  rateCardItems         RateCardItem[]
  featureRoleHours      FeatureRoleHours[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("roles")
}

model Person {
  id                  String       @id @default(uuid())
  organizationId      String
  roleId              String
  name                String
  email               String?
  payType             PayType      @default(MONTHLY_SALARY)
  currency            String       @default("ETB")
  // Money fields stored as integer minor units (BigInt)
  basicSalaryMinor    BigInt       @default(0)
  allowancesMinor     BigInt       @default(0)
  benefitsMinor       BigInt       @default(0)
  directHourlyRateMinor BigInt     @default(0)
  paidHoursPerMonth   Int          @default(160)
  utilizationRate     Float        @default(0.70)
  isEthiopianNational Boolean      @default(true)
  pensionRate         Float        @default(0.11)
  pensionBase         PensionBase  @default(BASIC)
  pensionCeilingMinor BigInt?
  isActive            Boolean      @default(true)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role                Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([roleId])
  @@map("people")
}

model RateCard {
  id             String         @id @default(uuid())
  organizationId String
  name           String
  currency       String         @default("ETB")
  effectiveFrom  DateTime
  isDefault      Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items          RateCardItem[]

  @@index([organizationId])
  @@map("rate_cards")
}

model RateCardItem {
  id             String    @id @default(uuid())
  rateCardId     String
  roleId         String
  hourlyRateMinor BigInt   // Client billing rate in minor units
  currency       String    @default("ETB")

  rateCard       RateCard  @relation(fields: [rateCardId], references: [id], onDelete: Cascade)
  role           Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([rateCardId, roleId])
  @@map("rate_card_items")
}

model Client {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  tin            String?      // Taxpayer Identification Number
  contactName    String?
  contactEmail   String?
  contactPhone   String?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projects       Project[]

  @@index([organizationId])
  @@map("clients")
}

model AuditLog {
  id             String       @id @default(uuid())
  organizationId String
  userId         String?
  action         String       // e.g. "USER_LOGIN", "UPDATE_FLOOR_MARGIN", "UPDATE_PERSON_COST"
  entityType     String       // e.g. "Person", "Organization", "RateCard", "TaxPack"
  entityId       String?
  oldValue       Json?
  newValue       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([userId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

enum CatalogCategory {
  HOSTING
  CDN
  DOMAIN
  SSL
  PAYMENT_GATEWAY
  LICENSE
  TOOL
  OTHER
}

enum PriceModel {
  FIXED
  PER_MONTH
  PER_USER
  PERCENTAGE
}

enum Payer {
  AGENCY
  CLIENT
}

enum NotificationType {
  STALE_CATALOG_PRICE
  STALE_EXCHANGE_RATE
  UNVERIFIED_TAX_RULE
  SYSTEM
}

enum NotificationSeverity {
  INFO
  WARNING
  ERROR
}

model CatalogItem {
  id             String          @id @default(uuid())
  organizationId String
  name           String
  category       CatalogCategory @default(TOOL)
  priceModel     PriceModel      @default(PER_MONTH)
  amountMinor    BigInt          @default(0) // Integer minor units (santim/cents)
  percentageRate Float?          // e.g. 0.035 for 3.5%
  currency       String          @default("ETB")
  sourceUrl      String?
  verifiedAt     DateTime        @default(now())
  payer          Payer           @default(CLIENT)
  staleAfterDays Int             @default(90)
  isExample      Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([category])
  @@map("catalog_items")
}

model ExchangeRate {
  id               String       @id @default(uuid())
  organizationId   String
  fromCurrency     String       // e.g. "USD", "EUR"
  toCurrency       String       @default("ETB")
  rate             Float        // ETB per 1 unit of fromCurrency
  source           String       // "NBE", "CBE", "MANUAL_OVERRIDE", "FALLBACK"
  isManualOverride Boolean      @default(false)
  effectiveAt      DateTime     @default(now())
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, fromCurrency, toCurrency])
  @@index([organizationId])
  @@map("exchange_rates")
}

model ExchangeRateHistory {
  id               String       @id @default(uuid())
  organizationId   String
  fromCurrency     String
  toCurrency       String       @default("ETB")
  rate             Float
  source           String
  isManualOverride Boolean
  capturedAt       DateTime     @default(now())

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([fromCurrency, toCurrency])
  @@map("exchange_rate_histories")
}

model Notification {
  id             String               @id @default(uuid())
  organizationId String
  type           NotificationType     @default(SYSTEM)
  severity       NotificationSeverity @default(INFO)
  title          String
  message        String
  entityType     String?              // "CatalogItem", "ExchangeRate", "TaxPack"
  entityId       String?
  isRead         Boolean              @default(false)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([isRead])
  @@index([type])
  @@map("notifications")
}

enum EstimateStatus {
  DRAFT
  ISSUED
  APPROVED
  ARCHIVED
}

enum EstimationMethod {
  THREE_POINT
  SINGLE_VALUE
  T_SHIRT
  STORY_POINTS
}

enum TShirtSize {
  XS
  S
  M
  L
  XL
}

model Project {
  id               String            @id @default(uuid())
  organizationId   String
  name             String
  description      String?
  clientId         String?
  currency         String            @default("ETB")
  isTemplate       Boolean           @default(false)
  templateCategory String?           // "E_COMMERCE", "SAAS", "MOBILE_APP", "LANDING_PAGE", "INTERNAL_TOOL", "MAINTENANCE"
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client           Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  versions         EstimateVersion[]
  modules          Module[]

  @@index([organizationId])
  @@index([clientId])
  @@map("projects")
}

model EstimateVersion {
  id                 String         @id @default(uuid())
  projectId          String
  versionNumber      Int            @default(1)
  name               String         @default("Initial Draft")
  status             EstimateStatus @default(DRAFT)
  pointsToHoursRatio Float          @default(8.0) // 1 story point = 8h
  tshirtSizeConfig   Json?          // custom { XS: 4, S: 8, M: 16, L: 40, XL: 80 }
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  project            Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, versionNumber])
  @@index([projectId])
  @@map("estimate_versions")
}

model Module {
  id          String    @id @default(uuid())
  projectId   String
  parentId    String?   // For WBS nesting
  name        String
  description String?
  orderIndex  Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent      Module?   @relation("ModuleNesting", fields: [parentId], references: [id], onDelete: Cascade)
  children    Module[]  @relation("ModuleNesting")
  features    Feature[]

  @@index([projectId])
  @@index([parentId])
  @@map("modules")
}

model Feature {
  id             String             @id @default(uuid())
  moduleId       String
  name           String
  description    String?
  method         EstimationMethod   @default(THREE_POINT)
  assignedUserId String?
  orderIndex     Int                @default(0)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  module         Module             @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  assignedUser   User?              @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  roleHours      FeatureRoleHours[]

  @@index([moduleId])
  @@index([assignedUserId])
  @@map("features")
}

model FeatureRoleHours {
  id               String      @id @default(uuid())
  featureId        String
  roleId           String
  optimisticHours  Float?
  likelyHours      Float?
  pessimisticHours Float?
  singleHours      Float?
  tshirtSize       TShirtSize?
  storyPoints      Float?
  expectedHours    Float       @default(0)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  feature          Feature     @relation(fields: [featureId], references: [id], onDelete: Cascade)
  role             Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([featureId, roleId])
  @@index([featureId])
  @@index([roleId])
  @@map("feature_role_hours")
}
